#: src/fenster.rs:519 src/fenster.rs:580
msgid "Processes of other users are only shown."
msgstr "Los procesos de otros usuarios solo se muestran."

#: src/fenster.rs:520
msgid "Only your own processes can be ended, killed or changed in priority."
msgstr ""
"Solo se pueden finalizar, matar o cambiar de prioridad sus propios procesos."

#: src/fenster.rs:527
#, no-c-format
msgid "End the process “{name}” (PID {pid})?"
msgstr "¿Finalizar el proceso «{name}» (PID {pid})?"

#: src/fenster.rs:531
msgid ""
"Ending a process may lose unsaved data. The process receives the signal SIGTERM and can still clean up."
msgstr ""
"Al finalizar un proceso pueden perderse datos no guardados. El proceso recibe la señal SIGTERM y todavía puede hacer limpieza."

#: src/fenster.rs:537
#, no-c-format
msgid "Kill the process “{name}” (PID {pid})?"
msgstr "¿Matar el proceso «{name}» (PID {pid})?"

#: src/fenster.rs:541
msgid ""
"Killing a process loses unsaved data. The process receives the signal SIGKILL and stops immediately."
msgstr ""
"Al matar un proceso se pierden los datos no guardados. El proceso recibe la señal SIGKILL y se detiene inmediatamente."

#: src/fenster.rs:562
#, no-c-format
msgid "“{name}” (PID {pid}) could not be ended."
msgstr "No se pudo finalizar «{name}» (PID {pid})."

#: src/fenster.rs:581
msgid "The priority can only be changed for your own processes."
msgstr "La prioridad solo se puede cambiar en sus propios procesos."

