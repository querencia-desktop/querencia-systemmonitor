[Desktop Entry]
# Querencia Systemmonitor. Desktop-ID = GApplication-ID org.querencia.Systemmonitor,
# damit labwc und die Fensterliste Titelleistensymbol und Namen finden.
# Vorlage: Name, GenericName, Comment und Keywords sind englisch; die
# Übersetzungen (Name[de]= …) setzt `werkzeug/i18n.py desktop` aus po/*.po
# ein (entspricht msgfmt --desktop). Erzeugt: org.querencia.Systemmonitor.desktop.
Type=Application
Version=1.5
Name[de]=Systemüberwachung
Name[es]=Monitor del sistema
Name[fr]=Moniteur système
Name[it]=Monitor di sistema
Name=System Monitor
GenericName[de]=Systemüberwachung
GenericName[es]=Monitor del sistema
GenericName[fr]=Moniteur système
GenericName[it]=Monitor di sistema
GenericName=System Monitor
Comment[de]=Laufende Prozesse anzeigen und den Systemzustand überwachen
Comment[es]=Ver los procesos actuales y monitorizar el estado del sistema
Comment[fr]=Afficher les processus en cours et surveiller l’état du système
Comment[it]=Visualizza i processi attivi e controlla lo stato del sistema
Comment=View current processes and monitor system state
Exec=querencia-systemmonitor
TryExec=querencia-systemmonitor
Icon=org.querencia.Systemmonitor
Terminal=false
Categories=GTK;System;Monitor;
Keywords[de]=Überwachung;System;Prozess;Prozessor;Speicher;Netzwerk;Task-Manager;
Keywords[es]=Monitor;Sistema;Proceso;CPU;Memoria;Red;Administrador de tareas;
Keywords[fr]=Moniteur;Système;Processus;CPU;Mémoire;Réseau;Gestionnaire de tâches;
Keywords[it]=Monitor;Sistema;Processo;CPU;Memoria;Rete;Task manager;
Keywords=Monitor;System;Process;CPU;Memory;Network;
StartupNotify=true
StartupWMClass=org.querencia.Systemmonitor
